@page "/salle/{donjonId:guid}/{idSalle:guid}"
@using System.Net.Http.Json
@using SharedModels.Domain.Gameplay
@using SharedModels.Domain.Common.Enums
@inject HttpClient Http
@inject NavigationManager Nav
@inject BlazorGame.Client.Services.GameState State

<link rel="stylesheet" href="css/salle.css">

<div class="salle-container" data-type="@SalleData?.Type.ToString().ToLower()">
    <video autoplay muted loop class="background-video">
        <source src="@GetVideoUrl()" type="video/mp4">
    </video>

    <div class="salle-content">
        <div class="topbar">
            <span class="score-badge">Score: <strong>@State.Score</strong></span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="error">@Error</div>
        }

        @if (Loading)
        {
            <div class="loading-salle">
                <div class="spinner"></div>
                <p>Chargement…</p>
            </div>
        }
        else if (DonjonData is null || SalleData is null)
        {
            <div class="error">Erreur de chargement.</div>
        }
        else
        {
            <div class="salle-card">
                <h1 class="salle-title">@SalleData.Titre</h1>
                <p class="salle-description">@SalleData.Description</p>

                <div class="salle-meta">
                    <span class="meta-badge">@SalleData.Type</span>
                    <span class="meta-badge">@SalleData.Difficulte</span>
                </div>

                <div class="choices-section">
                    <h3>Que fais-tu ?</h3>
                    @if (SalleData.ChoixProposes?.Count > 0)
                    {
                        <div class="choices-grid">
                            @foreach (var c in SalleData.ChoixProposes)
                            {
                                <button class="choice-btn" disabled="@HasChosen" @onclick="() => Choose(c)">
                                    @c.Libelle
                                </button>
                            }
                        </div>
                    }
                </div>

                @if (HasChosen)
                {
                    <div class="result-panel">
                        <div class="result-line">@ChoiceResult</div>
                        @if (Dead)
                        {
                            <div class="result-death">MORT</div>
                        }
                        else
                        {
                            <div class="result-score">Score: <strong>@State.Score</strong></div>
                        }
                    </div>

                    <div class="action-buttons">
                        @if (!Dead && NextSalleId is not null)
                        {
                            <button class="btn-continue" @onclick="GoNext">Continuer →</button>
                        }
                        else
                        {
                            <button class="btn-finish" @onclick="@(() => Nav.NavigateTo($"/donjon/{donjonId}"))">Retour au donjon</button>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public Guid donjonId { get; set; }
    [Parameter] public Guid idSalle { get; set; }

    private string Error = string.Empty;
    private bool Loading;
    private Donjon? DonjonData;
    private Salle? SalleData;
    private Guid? NextSalleId;

    private bool HasChosen;
    private bool Dead;
    private string ChoiceResult = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        Error = string.Empty;
        Loading = true;
        HasChosen = false;
        Dead = false;
        ChoiceResult = string.Empty;

        try
        {
            DonjonData = await Http.GetFromJsonAsync<Donjon>($"/api/donjons/{donjonId}");
            if (DonjonData?.Salles is null || DonjonData.Salles.Count == 0) return;

            var list = DonjonData.Salles.ToList();
            SalleData = list.FirstOrDefault(s => s.Id == idSalle);
            if (SalleData is null) return;

            var idx = list.FindIndex(s => s.Id == idSalle);
            NextSalleId = (idx >= 0 && idx + 1 < list.Count) ? list[idx + 1].Id : null;

            if (idx == 0) State.Reset();
        }
        catch (Exception ex)
        {
            Error = $"Erreur: {ex.Message}";
        }
        finally { Loading = false; }
    }

    private string GetVideoUrl()
    {
        return SalleData?.Type switch
        {
            TypeSalle.Combat => "/videos/combat.mp4",
            TypeSalle.Coffre => "/videos/coffre.mp4",
            TypeSalle.Piege => "/videos/piege.mp4",
            TypeSalle.Rencontre => "/videos/rencontre.mp4",
            TypeSalle.Enigme => "/videos/enigme.mp4",
            _ => "/videos/repos.mp4"
        };
    }

    private async Task Choose(Choix c)
    {
        if (HasChosen || c is null || State.PartieId is null) return;

        try
        {
            Loading = true;
            var response = await Http.PostAsJsonAsync($"/api/parties/{State.PartieId}/choisir", new
            {
                SalleId = idSalle,
                ChoixId = c.Id
            });

            if (!response.IsSuccessStatusCode)
            {
                Error = $"Erreur: {response.StatusCode}";
                Loading = false;
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<ChoisirResponse>();
            if (result is null)
            {
                Error = "Réponse invalide.";
                Loading = false;
                return;
            }

            State.SetScore(result.Score);
            Dead = result.Mort;
            ChoiceResult = Dead ? "Vous êtes tombé au combat..." : $"{c.Libelle} — +{result.Score} points";

            if (result.Fini) State.SetFinished();
            HasChosen = true;
        }
        catch (Exception ex)
        {
            Error = $"Erreur: {ex.Message}";
        }
        finally { Loading = false; }
    }

    private class ChoisirResponse
    {
        public int Score { get; set; }
        public bool Mort { get; set; }
        public bool Fini { get; set; }
    }

    private void GoNext()
    {
        if (NextSalleId is null || Dead) return;
        Nav.NavigateTo($"/salle/{donjonId}/{NextSalleId}");
    }
}