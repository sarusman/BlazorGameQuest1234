@attribute [Authorize]
@page "/history"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@using SharedModels.Domain.Scores;

<link rel="stylesheet" href="css/history.css">

<div class="history">
    <h2>Historique des parties</h2>
    <p>Vos derniers scores enregistrés</p>

    @if (loading)
    {
        <p>Chargement</p>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="error">@error</div>
    }
    else
    {
        @if (items.Count == 0)
        {
            <div class="muted">Aucun score enregistré.</div>
        }
        else
        {
            @foreach (var g in items)
            {
                <div class="game @(g.Status.ToLower())">
                    <div>
                        <strong>@g.Date</strong> — <b>@g.Joueur</b> — Score: @g.Score
                    </div>
                    <span class="status">@g.Status</span>
                    @if (g.Inventaire.Count > 0)
                    {
                        <div class="inventaire">Inventaire final :
                            @foreach (var item in g.Inventaire)
                            {
                                <span>@item.Objet (@item.Quantite)</span>
                            }
                        </div>
                    }
                </div>
            }

            <div class="stats">
                <div>Total : @items.Count</div>
                <div>Victoires : @items.Count(g => g.Status == "Victoire")</div>
                <div>Meilleur score : @items.Max(g => g.Score)</div>
            </div>
        }
    }

    <button @onclick="GoBack">Retour</button>
</div>

@code {
    private List<Row> items = new();
    private bool loading;
    private string error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var pseudo = user?.Identity?.Name ?? user?.FindFirst("preferred_username")?.Value ?? "";
            Console.WriteLine($"History: pseudo={pseudo}");
            
            var pseudoNorm = (pseudo ?? "").Trim().ToLowerInvariant();
            Console.WriteLine($"History: pseudoNorm={pseudoNorm}");
            
            var history = await Http.GetFromJsonAsync<List<HistoryRow>>("/api/scores/history-full") ?? new();
            Console.WriteLine($"History: received {history.Count} items");
            
            // History: Afficher TOUS les scores de TOUS les utilisateurs
            items = history
                .OrderByDescending(s => s.Date)
                .Select(s => new Row(
                    s.Date.ToLocalTime().ToString("yyyy-MM-dd HH:mm"),
                    s.Score,
                    s.Score > 0 ? "Victoire" : "Défaite",
                    s.Joueur,
                    s.Inventaire
                ))
                .ToList();
            Console.WriteLine($"History: showing all {items.Count} items (from all users)");
        }
        catch (Exception ex)
        {
            error = $"Erreur: {ex.Message}";
            Console.WriteLine($"History ERROR: {ex}");
        }
        finally { loading = false; }
    }

    private void GoBack() => Navigation.NavigateTo("/");

    private record Row(string Date, int Score, string Status, string Joueur, List<InvItem> Inventaire);
    private class HistoryRow
    {
        public string Joueur { get; set; } = string.Empty;
        public int Score { get; set; }
        public DateTime Date { get; set; }
        public List<InvItem> Inventaire { get; set; } = new();
    }
    private class InvItem
    {
        public string Objet { get; set; } = string.Empty;
        public int Quantite { get; set; }
    }
}
