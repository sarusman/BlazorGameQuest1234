@page "/"

<div class="home-container">
    <div class="background-slider">
        <div class="bg-slide bg-slide-1"></div>
        <div class="bg-slide bg-slide-2"></div>
        <div class="bg-slide bg-slide-3"></div>
    </div>

    <div class="content-overlay">
        <div class="hero-section">
            <button class="btn-play" @onclick="StartAdventure">Jouer</button>
        </div>
    </div>

    <nav class="bottom-nav">
        <a href="/creer-utilisateur" class="nav-link">Créer un utilisateur</a>
        <a href="/se-connecter" class="nav-link">Se connecter</a>
        <a href="/informations" class="nav-link">Informations</a>
    </nav>
</div>

@inject NavigationManager Navigation

@code {
    private void StartAdventure() => Navigation.NavigateTo("/dashboard");
}