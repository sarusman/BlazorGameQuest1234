@page "/"

<div class="home-container">
    <div class="background-slider">
        <div class="bg-slide bg-slide-1"></div>
        <div class="bg-slide bg-slide-2"></div>
        <div class="bg-slide bg-slide-3"></div>
    </div>

    <div class="content-overlay">
        <div class="hero-section">
            <button class="btn-play" @onclick="StartAdventure">Jouer</button>
        </div>
    </div>

    <nav class="bottom-nav">
        <a href="/inscription" class="nav-link">Créer un utilisateur</a>
        <a href="/connexion" class="nav-link">Se connecter</a>
        <a href="/history" class="nav-link">Classement</a>
    </nav>
</div>

@inject NavigationManager Navigation

@code {
    private void StartAdventure()
    {
        Navigation.NavigateTo("/new-adventure");
    }
}
