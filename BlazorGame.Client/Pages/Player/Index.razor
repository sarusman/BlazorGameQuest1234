@page "/"

<div class="dashboard">
    <div class="welcome">
        <h2>Salut, @playerName</h2>
        <p>Voici un petit aperçu de ton aventure :</p>

        <div class="stats">
            <div>
                <h4>Meilleur score</h4>
                <span>@bestScore</span>
            </div>
            <div>
                <h4>Parties jouées</h4>
                <span>@totalGames</span>
            </div>
        </div>
    </div>

    <div class="recent">
        <h3>Dernières parties</h3>

        @foreach (var game in recentGames)
        {
            <div class="game @game.Status.ToLower()">
                <div>
                    <strong>@game.Date</strong> — Score : @game.Score
                </div>
                <span class="status">@game.Status</span>
            </div>
        }

        <button class="btn" @onclick="GoToHistory">Voir tout l’historique</button>
    </div>

    <div class="actions">
        <button class="btn start" @onclick="StartNewAdventure">Commencer une nouvelle aventure ⚔️</button>
    </div>
</div>

@inject NavigationManager Navigation

@code {
    private string playerName = "Aventurier";
    private int bestScore = 1250;
    private int totalGames = 8;

    private List<Game> recentGames = new()
    {
        new("2024-01-15", 1250, "Victoire"),
        new("2024-01-14", 890, "Défaite"),
        new("2024-01-13", 1100, "Victoire")
    };

    private void StartNewAdventure() => Navigation.NavigateTo("/new-adventure");
    private void GoToHistory() => Navigation.NavigateTo("/history");

    public record Game(string Date, int Score, string Status);
}
