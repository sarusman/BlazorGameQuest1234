@page "/inscription"

@inject HttpClient Http

<h2>Créer un utilisateur</h2>

@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <div style="color: green">@SuccessMessage</div>
}
@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div style="color: red">@ErrorMessage</div>
}

<div style="display:flex;flex-direction:column;gap:0.5rem;max-width:300px">
    <label>
        Pseudo
        <input @bind="Pseudo" />
    </label>

    <label>
        Email
        <input @bind="Email" type="email" />
    </label>

    <button @onclick="RegisterAsync">Créer</button>
</div>

@code {
    private string Pseudo = string.Empty;
    private string Email = string.Empty;

    private string SuccessMessage = string.Empty;
    private string ErrorMessage = string.Empty;

    /// <summary>
    /// Appelle POST /api/joueurs/register pour créer un joueur.
    /// </summary>
    private async Task RegisterAsync()
    {
        SuccessMessage = string.Empty;
        ErrorMessage = string.Empty;

        var body = new
        {
            pseudo = Pseudo,
            email = Email
        };

        try
        {
            var response = await Http.PostAsJsonAsync("/api/joueurs/register", body);

            if (response.IsSuccessStatusCode)
            {
                // backend renvoie le Joueur créé
                var createdJoueur = await response.Content.ReadFromJsonAsync<JoueurResponse>();

                SuccessMessage = $"Créé: {createdJoueur?.Pseudo} (Id: {createdJoueur?.Id})";
                Pseudo = string.Empty;
                Email = string.Empty;
            }
            else
            {
                ErrorMessage = $"Erreur API ({(int)response.StatusCode})";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Erreur client: {ex.Message}";
        }
    }

    /// <summary>
    /// Représente le Joueur renvoyé par l'API après l'inscription.
    /// Doit matcher ce que le backend renvoie dans Ok(joueur).
    /// </summary>
    private class JoueurResponse
    {
        public Guid Id { get; set; }
        public string Pseudo { get; set; } = string.Empty;
        public bool Actif { get; set; } // si ça n'existe pas dans ton modèle actuel c'est pas grave que ça reste vide
    }
}
