@page "/connexion"
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="connexion-container">
    <div class="connexion-card">
        <h1>Se connecter</h1>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="error-message">@error</div>
        }

        <div class="form-group">
            <input class="input-field"
                   placeholder="Pseudo"
                   @bind="pseudo" />
        </div>

        <button class="btn-connect"
                @onclick="Connecter"
                disabled="@loading">
            @(loading ? "Connexion..." : "Se connecter")
        </button>

        <p class="footer-text">
            Pas de compte ?
            <a href="/inscription">S'inscrire</a>
        </p>
    </div>
</div>

@code {
    private string pseudo = "";
    private string error = "";
    private bool loading = false;

    private async Task Connecter()
    {
        error = "";
        if (string.IsNullOrWhiteSpace(pseudo)) { error = "Entrez un pseudo."; return; }
        loading = true;
        try
        {
            var res = await Http.PostAsJsonAsync("/api/joueurs/login", new { Pseudo = pseudo });
            if (!res.IsSuccessStatusCode) { error = "Pseudo introuvable."; return; }

            var j = await res.Content.ReadFromJsonAsync<JoueurDto>();
            if (j is null) { error = "Réponse invalide."; return; }

            await JS.InvokeVoidAsync("localStorage.setItem", "pseudo", j.Pseudo);
            await JS.InvokeVoidAsync("localStorage.setItem", "joueurId", j.Id.ToString());
            await JS.InvokeVoidAsync("eval", $"document.cookie='pseudo={j.Pseudo};path=/;max-age=31536000'");
            await JS.InvokeVoidAsync("eval", $"document.cookie='joueurId={j.Id};path=/;max-age=31536000'");

            Nav.NavigateTo("/");
        }
        catch (Exception ex) { error = $"Erreur: {ex.Message}"; }
        finally { loading = false; }
    }

    private class JoueurDto { public Guid Id { get; set; } public string Pseudo { get; set; } = ""; }
}
