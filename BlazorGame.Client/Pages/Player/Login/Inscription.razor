@page "/inscription"
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<h2>Créer un compte</h2>

@if (!string.IsNullOrWhiteSpace(error)) { <div style="color:#c00">@error</div> }

<input placeholder="Choisissez un pseudo" @bind="pseudo" style="padding:.5rem;width:260px" />
<button style="margin-left:.5rem;padding:.5rem 1rem" @onclick="Creer" disabled="@loading">S’inscrire</button>

@code {
    private string pseudo = "";
    private string error = "";
    private bool loading = false;

    private async Task Creer()
    {
        error = "";
        if (string.IsNullOrWhiteSpace(pseudo)) { error = "Entrez un pseudo."; return; }

        loading = true;
        try
        {
            var res = await Http.PostAsJsonAsync("/api/joueurs/register", new { Pseudo = pseudo });
            if (!res.IsSuccessStatusCode) { error = $"API {res.StatusCode}"; return; }

            var j = await res.Content.ReadFromJsonAsync<JoueurDto>();
            if (j is null) { error = "Réponse invalide."; return; }

            await JS.InvokeVoidAsync("localStorage.setItem", "pseudo", j.Pseudo);
            await JS.InvokeVoidAsync("localStorage.setItem", "joueurId", j.Id.ToString());
            await JS.InvokeVoidAsync("eval", $"document.cookie='pseudo={j.Pseudo};path=/;max-age=31536000'");
            await JS.InvokeVoidAsync("eval", $"document.cookie='joueurId={j.Id};path=/;max-age=31536000'");

            Nav.NavigateTo("/");
        }
        catch (Exception ex) { error = $"Erreur: {ex.Message}"; }
        finally { loading = false; }
    }

    private class JoueurDto { public Guid Id { get; set; } public string Pseudo { get; set; } = ""; }
}
