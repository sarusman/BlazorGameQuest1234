@page "/"

<link rel="stylesheet" href="css/home.css">

<div class="home-container">
    <video autoplay muted loop>
        <source src="videos/background.mp4" type="video/mp4">
    </video>

    <div class="hero-section">
        <button class="btn-play" @onclick="StartAdventure">Nouvelle aventure</button>
    </div>

    <nav class="bottom-nav">
        <a href="/inscription" class="nav-link">Créer un utilisateur</a>
        <a href="/connexion" class="nav-link">Se connecter</a>
        <a href="/history" class="nav-link">Classement</a>
    </nav>
</div>

@inject NavigationManager Navigation

@code {
    private void StartAdventure()
    {
        Navigation.NavigateTo("/new-adventure");
    }
}