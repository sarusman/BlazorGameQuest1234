@page "/IsVictory/{donjonId:guid}"
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav

<link rel="stylesheet" href="css/victory.css">

<div class="victory-container">
    <video autoplay muted loop class="background-video">
        <source src="@GetVideoUrl()" type="video/mp4">
    </video>

    <div class="victory-content">
        @if (Loading)
        {
            <div class="loading">
                <div class="spinner"></div>
                <p>Calcul des résultats…</p>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="error-message">@Error</div>
        }
        else if (Scores != null && Scores.Count > 0)
        {
            <div class="victory-card @(IsVictory ? "victory" : "defeat")">
                <h1 class="result-title">@(IsVictory ? "VICTOIRE" : "DEFAITE")</h1>
                <p class="result-subtitle">@(IsVictory ? "Vous avez survécu au donjon !" : "Vous êtes tombé au combat...")</p>

                <div class="leaderboard">
                    <h2>Meilleurs scores</h2>
                    <div class="scores-list">
                        @for (int i = 0; i < Math.Min(5, Scores.Count); i++)
                        {
                            var score = Scores[i];
                            var rankClass = i == 0 ? "rank-1" : i == 1 ? "rank-2" : i == 2 ? "rank-3" : "";
                            <div class="score-row @rankClass">
                                <span class="rank">@(i + 1)</span>
                                <span class="score-value">@score pts</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="action-buttons">
                    <button class="btn-retry" @onclick="RetryGame">
                        Recommencer
                    </button>
                    <button class="btn-home" @onclick="GoHome">
                        Accueil
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="error-message">Aucun score disponible.</div>
        }
    </div>
</div>
@code {
    [Parameter] public Guid donjonId { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "victory")] public bool IsVictory { get; set; } = true;

    private List<int> Scores = new();
    private bool Loading;
    private string Error = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Loading = true;
        Error = string.Empty;

        try
        {
            var scoresList = await Http.GetFromJsonAsync<List<ScoreDto>>($"/api/scores/score/{donjonId}") ?? new();
            Scores = scoresList.OrderByDescending(x => x.Valeur).Select(x => x.Valeur).ToList();
        }
        catch (Exception ex)
        {
            Error = $"Erreur: {ex.Message}";
        }
        finally { Loading = false; }
    }

    private string GetVideoUrl()
    {
        return IsVictory ? "/videos/victory-background.mp4" : "/videos/defeat-background.mp4";
    }

    private void RetryGame()
    {
        Nav.NavigateTo("/new-adventure");
    }

    private void GoHome()
    {
        Nav.NavigateTo("/");
    }

    private class ScoreDto
    {
        public Guid JoueurId { get; set; }
        public Guid PartieId { get; set; }
        public int Valeur { get; set; }
        public DateTime EnregistreLe { get; set; }
    }
}