@page "/history"

<div class="history">
    <h2>Historique des parties</h2>
    <p>Retrouvez ici toutes vos parties jouées</p>

    @foreach (GameHistory game in allGames)
    {
        <div class="game @game.Status.ToLower()">
            <div>
                <strong>@game.Date</strong> — Score: @game.Score — Durée: @game.Duration
            </div>
            <span class="status">@game.Status</span>
        </div>
    }

    <div class="stats">
        <div>Total : @allGames.Count</div>
        <div>Victoires : @allGames.Count(g => g.Status == "Victoire")</div>
        <div>Meilleur score : @allGames.Max(g => g.Score)</div>
    </div>

    <button @onclick="GoBack">Retour</button>
</div>

@inject NavigationManager Navigation

@code {
    private List<GameHistory> allGames = new()
    {
        new GameHistory("2024-01-15", 1250, "Victoire", "15 min"),
        new GameHistory(Date: "2024-01-14", Score: 890, "Défaite", "8 min"),
        new GameHistory(Date: "2024-01-13", Score: 1100, "Victoire", "12 min"),
        new GameHistory(Date: "2024-01-12", Score: 750, "Défaite", "6 min"),
        new GameHistory("2024-01-11", 980, "Victoire", "14 min"),
        new GameHistory("2024-01-10", 650, "Défaite", "5 min"),
        new GameHistory("2024-01-09", 1350, "Victoire", "18 min"),
        new GameHistory("2024-01-08", 920, "Victoire", "11 min")
    };

    private void GoBack() => Navigation.NavigateTo("/");

    public record GameHistory(string Date, int Score, string Status, string Duration);
}
