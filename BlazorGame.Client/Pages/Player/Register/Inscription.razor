@page "/inscription"
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="inscription-container">
    <div class="inscription-card">
        <h1>Créer un compte</h1>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="error-message">@error</div>
        }

        <div class="form-group">
            <input class="input-field"
                   placeholder="Choisissez un pseudo"
                   @bind="pseudo" />
        </div>

        <button class="btn-register"
                @onclick="Creer"
                disabled="@loading">
            S’inscrire
        </button>

        <div class="footer-text">
            Vous avez déjà un compte ?
            <a href="/connexion">Se connecter</a>
        </div>
    </div>
</div>

@code {
    private string pseudo = "";
    private string error = "";
    private bool loading = false;

    private async Task Creer()
    {
        error = "";
        if (string.IsNullOrWhiteSpace(pseudo))
        {
            error = "Entrez un pseudo.";
            return;
        }

        loading = true;
        try
        {
            var res = await Http.PostAsJsonAsync("/api/joueurs/register", new { Pseudo = pseudo });
            if (!res.IsSuccessStatusCode) { error = $"API {res.StatusCode}"; return; }

            var j = await res.Content.ReadFromJsonAsync<JoueurDto>();
            if (j is null) { error = "Réponse invalide."; return; }

            await JS.InvokeVoidAsync("localStorage.setItem", "pseudo", j.Pseudo);
            await JS.InvokeVoidAsync("localStorage.setItem", "joueurId", j.Id.ToString());
            await JS.InvokeVoidAsync("eval", $"document.cookie='pseudo={j.Pseudo};path=/;max-age=31536000'");
            await JS.InvokeVoidAsync("eval", $"document.cookie='joueurId={j.Id};path=/;max-age=31536000'");

            Nav.NavigateTo("/connexion");
        }
        catch (Exception ex) { error = $"Erreur: {ex.Message}"; }
        finally { loading = false; }
    }

    private class JoueurDto
    {
        public Guid Id { get; set; }
        public string Pseudo { get; set; } = "";
    }
}
